[Unit]
Description=Colmena: guardián de terminales

[Service]
Type=simple
WorkingDirectory=%h/Proyectos/orquestador
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run colmena-guardian
Restart=on-failure
RestartSec=3
UMask=0077
TimeoutStopSec=20

[Install]
WantedBy=default.target
