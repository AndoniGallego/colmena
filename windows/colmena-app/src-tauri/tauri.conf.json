{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Colmena",
  "version": "0.1.0",
  "identifier": "app.colmena.notch",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'",
      "capabilities": ["origen", "notebook", "atajos", "nudo", "nudo-globo"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwRkQ0NzIwQzBGNkQxOEUKUldTTzBmYkFJRWY5a0dSQTJGNDFJWE1QcGRhT0dEWGNiYytiaE01bFlxMlNnYTVQQnNVT1NzK0EK",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
